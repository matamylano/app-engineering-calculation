# Copia este archivo a .env (Docker) o .env.local (npm run dev).
# Vacío = modo demostración: código 123456, firmante@demo.mx y pagos simulados.

# Cuentas y base de datos (las tres activan el modo real).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firma la cookie de sesión. 32 caracteres o más: openssl rand -base64 48
SESION_SECRETO=

# Correos que entran al panel de firma, separados por coma.
FIRMANTES=

# Cobros con Stripe (usa las llaves de prueba sk_test_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# URL desde la que abres la app, para los regresos de Stripe.
APP_URL=http://localhost:3000

# WhatsApp: simulado (solo registra), hub o directo.
WHATSAPP_MODO=simulado
HUB_URL=
HUB_API_KEY=
HUB_WEBHOOK_SECRETO=
# WhatsApp del ingeniero, para avisarle de memorias por revisar.
AVISO_FIRMA_TELEFONO=

# Agente de ventas (agentsales). Sin estas, el envío de prospectos se simula.
AGENTSALES_URL=
AGENTSALES_API_KEY=
AGENTSALES_TENANT_ID=
